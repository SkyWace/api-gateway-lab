{
  "realm": "lab",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "sslRequired": "none",
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "lab-fixed-rsa",
        "providerId": "rsa",
        "config": {
          "priority": [
            "200"
          ],
          "enabled": [
            "true"
          ],
          "active": [
            "true"
          ],
          "algorithm": [
            "RS256"
          ],
          "privateKey": [
            ""
          ],
          "certificate": [
            ""
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "lab-client",
      "enabled": true,
      "publicClient": false,
      "secret": "lab-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "gateway",
      "enabled": true,
      "publicClient": false,
      "secret": "gateway-secret",
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@lab.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Lab",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ]
    }
  ]
}